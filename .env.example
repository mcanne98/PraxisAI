# Praxis Intelligence — environment variables
# Copy to .env.local for local development. Never commit real values.
# Variables are read at BUILD time for static pages: rebuild/redeploy after changing them.

# ---------------------------------------------------------------------------
# Site
# ---------------------------------------------------------------------------
# Canonical origin used for metadata, sitemap and structured data. No trailing slash.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Search engine indexing. Leave unset (or anything but "true") for previews and
# pre-launch environments: robots.txt will disallow all crawling.
# Set to "true" ONLY on the approved production deployment.
ALLOW_INDEXING=

# ---------------------------------------------------------------------------
# Lead delivery (contact form, Academy interest, assessment follow-up)
# If NO channel below is configured, forms validate input but clearly tell the
# visitor that their submission was not sent.
# ---------------------------------------------------------------------------

# Email (default: Cloudflare Email Service via the Worker's EMAIL binding — no API key).
# LEAD_TO_EMAIL: inbox that receives leads. Must be a VERIFIED Email Routing destination
#   (free on all plans). In production it is a Cloudflare secret + build variable.
# LEAD_FROM_EMAIL: sender on a routing domain. Production value lives in .env.production.
LEAD_TO_EMAIL=
LEAD_FROM_EMAIL=
# Optional: set to use Resend instead of Cloudflare (sender domain must be verified in Resend).
RESEND_API_KEY=

# Generic CRM / automation webhook (HubSpot workflow, Zapier, Make, n8n, etc.).
# Receives the Lead JSON payload via POST.
CRM_WEBHOOK_URL=
# Optional shared secret sent as the X-Praxis-Webhook-Secret header.
CRM_WEBHOOK_SECRET=

# Max form submissions per IP, per form, per 10 minutes (default 5).
FORM_RATE_LIMIT=

# ---------------------------------------------------------------------------
# Insights
# ---------------------------------------------------------------------------
# Optional RSS/Atom feed for the founder's blog. Must be https on blog.cedricanne.com.
# Posts are linked out (never republished). Example: https://blog.cedricanne.com/feed
BLOG_FEED_URL=
